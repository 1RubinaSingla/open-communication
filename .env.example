# --- Orchestrator ---
ORCH_PORT=4000
ORCH_HOST=0.0.0.0
# Shared secret used to sign dev auth tokens and to authenticate workers.
ORCH_SECRET=dev-secret-change-me
# Path to the sqlite database file (created on first run).
DB_PATH=./data/0c.sqlite
# Credits granted to a brand-new user (1 credit = $0.01).
SIGNUP_GRANT_CREDITS=500

# --- Web ---
# Public URL of the orchestrator's socket + REST surface, reachable from the browser.
NEXT_PUBLIC_ORCH_URL=http://localhost:4000

# --- Native worker ---
WORKER_ORCH_URL=http://localhost:4000
WORKER_SECRET=dev-secret-change-me
WORKER_NAME=native-1
# If OLLAMA_URL is set and reachable, the worker serves real models via Ollama.
# Otherwise it falls back to a built-in streaming echo model so the pipeline still runs.
OLLAMA_URL=http://localhost:11434
WORKER_MODELS=echo,llama3.2

# --- Solana deposits ---
# Flip to mainnet by changing CLUSTER + RPC + TREASURY. SOL_USD_PRICE feeds the
# SOL->credits conversion (use a real price oracle in production).
DEPOSITS_ENABLED=true
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
TREASURY_ADDRESS=DDEqi2y5YLsEUYdavkfEHKbJmSxF4TfA8Xj99LqerV5m
SOL_USD_PRICE=150

# --- Agent web search (optional) ---
# Set ONE for real general web results; otherwise a keyless Wikipedia+DDG
# fallback is used. Priority: Tavily > Brave > Serper.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=

# --- Withdrawals (credits -> SOL payout) ---
# OFF unless WITHDRAWALS_ENABLED=true AND TREASURY_SECRET_KEY is set. The signing
# key must control TREASURY_ADDRESS. Fund the treasury with SOL to pay out.
WITHDRAWALS_ENABLED=false
# TREASURY_SECRET_KEY=   # base58 (Phantom export) | JSON array | base64 of 64 bytes
WITHDRAW_MIN=100          # credits ($1)
WITHDRAW_MAX_REQUEST=5000 # credits ($50)
WITHDRAW_MAX_DAY=20000    # credits ($200) per user per day

# --- $0C buyback-and-burn keeper (run on a schedule; activates after $0C is live) ---
KEEPER_ENABLED=false
KEEPER_DRY_RUN=true
BUYBACK_SOL=0.05
# OC_MINT=   # the $0C mint address (server-only; never exposed on the site)

# --- Contact form (apps/web) ---
# Without RESEND_API_KEY the form falls back to opening a prefilled mail draft.
# Set it (resend.com) to send server-side to contact@opencommunication.app.
# RESEND_API_KEY=
# CONTACT_TO=contact@opencommunication.app
# CONTACT_FROM=Open Communication <noreply@yourdomain>

# --- Harmonic Aristotle (formally-verified math) ---
# OPTIONAL. When set, adds the `verified_math` agent tool and the
# `aristotle-verified` model. NOTE: this is the ONE path where a prompt leaves
# the 0_C network (sent to Harmonic under their terms) — the UI labels it.
# Get a key at https://aristotle.harmonic.fun (Dashboard -> API Keys).
# ARISTOTLE_API_KEY=
# Wire contract matches Harmonic's official aristotlelib SDK (X-API-Key, /api/v3).
# ARISTOTLE_BASE_URL=https://aristotle.harmonic.fun/api/v3
# Aristotle is an agent, not a fast endpoint — proofs can take minutes.
# ARISTOTLE_TIMEOUT_MS=900000
# Price per verified run (credits). Trivial arithmetic is pre-filtered and
# answered locally for 1 credit without ever reaching Aristotle.
# ARISTOTLE_CREDITS=100

# --- X (Twitter) bot: /prove gated on $0C holdings ---
# Safe by default: does nothing unless X_BOT_ENABLED=true, and never posts
# unless X_BOT_DRY_RUN=false. Replies are plain text on purpose — X charges
# $0.015 per post but $0.20 if it contains a URL.
X_BOT_ENABLED=false
X_BOT_DRY_RUN=true
X_BOT_HANDLE=O_C_          # the bot account's username (no @)
# X_BEARER_TOKEN=          # X API v2 bearer token (pay-per-use)
X_BOT_POLL_MS=120000
X_BOT_DAILY_CAP=50         # global replies/run — bounds your X spend
# Holder tiers (needs OC_MINT set; enforced once $0C is live)
XBOT_TIER1_TOKENS=1000000    # limited access
XBOT_TIER2_TOKENS=10000000   # unlimited
XBOT_TIER1_DAILY=5           # requests/day at tier 1

# --- Provenance attestations ---
# 0_C signs a record binding each external run to its project + exact prompt, so
# anyone can verify we commissioned it (see /attest/key and /proof/<runId>).
# A key is generated and persisted on first boot; set this to pin or rotate it.
# ATTEST_SECRET_KEY=      # ed25519 secret key, hex
PUBLIC_DOMAIN=opencommunication.app

# --- Backups ---
# The DB holds the credit ledger, attestation key and X links on a single volume.
# Run scripts/backup-db.ts on a schedule, AND pull copies off-volume with:
#   curl -H "x-admin-secret: $ORCH_SECRET" <orch>/admin/backup -o 0c-backup.sqlite
BACKUP_KEEP=14
# BACKUP_DIR=./data/backups
