{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    // Workspace packages are consumed as TypeScript source (their "main" points
    // at src/index.ts), so no .d.ts is ever emitted or read. Emitting them only
    // produces TS4058-style errors for types that can't be named across
    // packages.
    "declaration": false,
    "sourceMap": true
  }
}
