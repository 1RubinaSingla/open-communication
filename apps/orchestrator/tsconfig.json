{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "lib": ["ES2022"]
  },
  // scripts are typechecked too: they touch money (deposits, payouts, the
  // keeper) and were previously invisible to `tsc`, so they could rot silently.
  "include": ["src", "scripts"]
}
